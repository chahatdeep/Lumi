__pycache__/
*.pyc
.venv/
venv/

# secrets / local config
.env
.env.*
*.pem
*.key

# logs & OS junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# editor
.vscode/
.idea/

# GitHub Pages build output
_site/

# local tooling
.claude/

# ad deliverables and previews (the site keeps its own copy in site/media)
/lumi-ad.mp4
/ad-preview*.mp4
/ad-music*.m4a
